# NP Wardrobe — Environment Variable Template
#
# Copy this file to .env.local and fill in real values for local development.
# NEVER commit .env.local or any file containing real credentials.
# This .env.example file contains only variable names and descriptions — no secrets.
#
# See docs/TRD.md §16.3 for the full secrets and environment variable policy.

# ─── Supabase ────────────────────────────────────────────────────────────────

# Public Supabase project URL — safe for browser bundles.
# Local development: http://127.0.0.1:54321
# Production: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public Supabase publishable key — preferred modern format.
# Use the project publishable key from Supabase Project Settings → API.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Backward compatibility for older local setups.
# Optional: keep only if your project still uses a legacy anon JWT key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_legacy_anon_key_here

# Service-role key — SERVER-SIDE ONLY. NEVER expose in browser bundles.
# Keep this in a server-only environment variable and never copy it into public client code.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ─── Application ─────────────────────────────────────────────────────────────

# Canonical site URL — used for auth redirect URLs, Open Graph, and canonical SEO.
# Local development: http://localhost:3000
# Production: https://www.npwardrobe.com.np (confirm after domain verification)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Product image uploads (Cloudinary) ─────────────────────────────────────
# Create API credentials in Cloudinary. These values are server-side only.
# Do not prefix API_KEY or API_SECRET with NEXT_PUBLIC_.
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# NP Wardrobe — Environment Variable Template
#
# Copy this file to .env.local and fill in real values for local development.
# NEVER commit .env.local or any file containing real credentials.
# This .env.example file contains only variable names and descriptions — no secrets.
#
# See docs/TRD.md §16.3 for the full secrets and environment variable policy.

# ─── Supabase ────────────────────────────────────────────────────────────────

# Public Supabase project URL — safe for browser bundles.
# Local development: http://127.0.0.1:54321
# Production: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://npwardrobe.supabase.co

# Public (anon/publishable) Supabase API key — safe for browser bundles.
# This key is subject to Row Level Security policies.
# Local development: use the anon key printed by `npx supabase status`.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Indud3ZtcHNrbmF3emJtcGd4aWt6Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTQ3NDEzNTgsImV4cCI6MjExMDMxNzM1OH0.HXg1cWDmSKCKyuBkky4T0JqKeJAQWpsaUWWKJkksch4

# Service-role key — SERVER-SIDE ONLY. NEVER expose in browser bundles.
# Bypasses RLS; use only in trusted server-only service modules.
# Local development: use the service_role key printed by `npx supabase status`.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Indud3ZtcHNrbmF3emJtcGd4aWt6Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5NDc0MTM1OCwiZXhwIjoyMTEwMzE3MzU4fQ.YJQvH1MuX1hjAjGgac-fS_z8kkyihKZqQRbVvGq7o7M

# ─── Application ─────────────────────────────────────────────────────────────

# Canonical site URL — used for auth redirect URLs, Open Graph, and canonical SEO.
# Local development: http://localhost:3000
# Production: https://www.npwardrobe.com.np (confirm after domain verification)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
